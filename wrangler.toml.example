# Cloudflare Wrangler 配置示例
# 复制为 wrangler.toml 并填入你的 D1 database_id。
# 也可以完全不用 Wrangler，直接在控制台粘贴 worker.mjs。

name = "mailbox"
main = "worker.mjs"
compatibility_date = "2026-01-01"

[[d1_databases]]
binding = "DB"
database_name = "mailbox"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[vars]
MAIL_DOMAIN = "example.com"
